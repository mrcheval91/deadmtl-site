---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('dispatch');
  return entries.map(entry => ({
    params: { slug: entry.data.slug },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function fmtDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  const months = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  return `${months[m - 1]} ${d}, ${y}`;
}

const statusClass = `status--${entry.data.status}`;
---

<Base
  title={entry.data.title}
  description={entry.data.excerpt}
>

  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <div class="eyebrow">
        <a href="/dispatch/" style="color: var(--text-muted); text-decoration: none;">&larr; Dispatch</a>
      </div>
      <h1
        class="section-title"
        style="font-size: clamp(1.3rem, 3.5vw, 2rem); margin-top: 0.75rem; margin-bottom: 1.5rem;"
      >
        {entry.data.title}
      </h1>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">

      <!-- Signal metadata header -->
      <div class="signal-header">
        <div class="sig__field">
          <span class="sig__label">Date</span>
          <span class="sig__value">{fmtDate(entry.data.date)}</span>
        </div>
        <div class="sig__field">
          <span class="sig__label">Zone</span>
          <span class="sig__value">{entry.data.zone}</span>
        </div>
        <div class="sig__field">
          <span class="sig__label">Signal</span>
          <span class="sig__value">{entry.data.signal}</span>
        </div>
        <div class="sig__field">
          <span class="sig__label">Status</span>
          <span class={`sig__value sig__value--status ${statusClass}`}>
            {entry.data.status}
          </span>
        </div>
      </div>

      <!-- Dispatch body -->
      <article class="dispatch-entry">
        <Content />
      </article>

      <!-- Bottom navigation -->
      <nav class="entry-nav" aria-label="Entry navigation">
        <a href="/dispatch/" class="btn btn--ghost">&larr; All Dispatches</a>
        <a href="/saint-paul-emard/" class="btn btn--secondary">Zone Dossier</a>
      </nav>

    </div>
  </section>

</Base>

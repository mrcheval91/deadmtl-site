---
import Base from '../../layouts/Base.astro';

// ─── Sector data ──────────────────────────────────────────────────────────────
const sectors = [
  {
    name: 'Saint-Paul-Emard',
    status: 'active',
    role: 'Entry Enclave',
    danger: 'medium',
    dangerMod: '--medium',
    desc: 'First active sector. Contained, fragmented, and still manageable. The starting point.',
    link: '/saint-paul-emard/',
  },
  {
    name: 'Ville-Emard Core',
    status: 'active',
    role: 'Residential Node',
    danger: 'medium',
    dangerMod: '--medium',
    desc: 'Duplexes, corner shops, ruelles, early caches. The heart of the first enclave.',
    link: '/saint-paul-emard/',
  },
  {
    name: 'Cote-Saint-Paul',
    status: 'active',
    role: 'Industrial Fringe',
    danger: 'high',
    dangerMod: '--high',
    desc: 'Industrial corridors east of the enclave. Workshops, garages, transit ruins, contested approach.',
    link: '/saint-paul-emard/',
  },
  {
    name: 'LaSalle Node',
    status: 'pressure',
    role: 'Pressure Source',
    danger: 'critical',
    dangerMod: '--critical',
    desc: 'Major horde source. Pont Mercier barricade failure origin. Not a playable zone in Season 0.',
    link: null,
  },
  {
    name: 'Canal Edge',
    status: 'active',
    role: 'Industrial Route',
    danger: 'high',
    dangerMod: '--high',
    desc: 'Cold waterline strip. Fog, workshops, containers. Useful loot, elevated movement risk.',
    link: '/saint-paul-emard/',
  },
  {
    name: 'Angrignon Buffer',
    status: 'planned',
    role: 'Green Buffer',
    danger: 'medium',
    dangerMod: '--medium',
    desc: 'Open park land, abandoned camps, migration from LaSalle. False calm. Future expansion zone.',
    link: null,
  },
  {
    name: 'Verdun Edge',
    status: 'locked',
    role: 'Closed Sector',
    danger: 'medium',
    dangerMod: '--medium',
    desc: 'Survivor pockets, rationing, tense access routes. Outside current build scope.',
    link: null,
  },
  {
    name: 'Saint-Henri Approach',
    status: 'planned',
    role: 'Future Expansion',
    danger: 'high',
    dangerMod: '--high',
    desc: 'Canal north bank. Industrial workshops, contested crossings. Planned expansion route.',
    link: null,
  },
  {
    name: 'Metro / Tunnel',
    status: 'placeholder',
    role: 'Underground Layer',
    danger: 'unknown',
    dangerMod: '--unknown',
    desc: 'Future underground survival layer. Stations, service rooms, blocked tunnels. Concept only.',
    link: null,
  },
  {
    name: 'Pont Mercier',
    status: 'pressure',
    role: 'Collapse Origin',
    danger: 'critical',
    dangerMod: '--critical',
    desc: 'Failed evacuation barricade. Primary horde flow source from the south. Sealed perimeter.',
    link: null,
  },
] as const;

// ─── Legend items ─────────────────────────────────────────────────────────────
const legend = [
  { mod: '--active',      label: 'Active — current build focus' },
  { mod: '--planned',     label: 'Planned — future scope' },
  { mod: '--locked',      label: 'Locked — outside current build' },
  { mod: '--pressure',    label: 'Pressure — threat / horde source' },
  { mod: '--placeholder', label: 'Placeholder — concept only' },
] as const;
---

<Base
  title="Map"
  description="DeadMTL sector map — southwest Montreal build scope. Saint-Paul-Emard, Ville-Emard, LaSalle pressure, canal edges, and future expansion zones."
>

<!-- ─── HERO ──────────────────────────────────────────────────────────────── -->
<section class="term-hero" style="padding-block: clamp(2.5rem,6vw,5rem);">
  <div class="th__inner">
    <div class="th__eyebrow">SURVEY DIVISION // MTL GRID // SEASON 0</div>
    <div class="th__headline" style="font-size: clamp(1.8rem,5vw,3.5rem);">Map &amp; Regions</div>
    <p class="th__body">
      DeadMTL starts with the southwest: Saint-Paul-&Eacute;mard, Ville-&Eacute;mard,
      C&ocirc;te-Saint-Paul, LaSalle pressure, canal edges, and future metro and tunnel placeholders.
    </p>
    <p style="font-family:var(--font-mono); font-size:0.72rem; color:var(--amber); letter-spacing:0.1em; margin-bottom:2rem;">
      The map is under construction. Sector names are planning labels, not a promise of playable completion.
    </p>
    <div class="th__cta">
      <a href="/saint-paul-emard/" class="term-btn term-btn--teal">S-P-E Dossier &rsaquo;</a>
      <a href="/knowledge/"        class="term-btn term-btn--ghost">Knowledge Center &rsaquo;</a>
      <a href="/"                  class="term-btn term-btn--ghost">&larr; Home</a>
    </div>
  </div>
</section>

<!-- ─── SECTOR GRID ───────────────────────────────────────────────────────── -->
<section class="home-section">
  <div class="container">
    <div class="hs__head">
      <span class="hs__label">MTL Grid // Southwest Sectors</span>
      <h2 class="hs__title">Sector Survey</h2>
      <p class="hs__sub">10 planning sectors. Season 0 active zones are shown in teal. All others are planned, locked, or under pressure.</p>
    </div>

    <!-- Legend -->
    <div class="sector-legend">
      {legend.map(item => (
        <span class="sl__item">
          <span class={`sl__dot sl__dot${item.mod}`}></span>
          {item.label}
        </span>
      ))}
    </div>

    <!-- Grid -->
    <div class="net-grid-panel" style="margin-top:0.75rem;">
      <div class="term-header">
        <span class="th__tag">Sector Grid // Southwest Montreal</span>
        <span class="th__rule"></span>
        <span class="th__info">Season 0 scope</span>
      </div>
      <div class="ngp__grid" role="list">
        {sectors.map(s => {
          const nodeClass = `net-node net-node--${s.status === 'pressure' ? 'hot' : s.status}`;
          const dotClass  = `node__dot node__dot--${s.status === 'pressure' ? 'hot' : s.status === 'active' ? 'active' : 'locked'}`;
          return s.link ? (
            <a class={nodeClass} href={s.link} role="listitem" style="text-decoration:none;">
              <span class={dotClass} aria-hidden="true"></span>
              <span class="node__name">{s.name}</span>
              <span class={`node__status node__status--${s.status === 'pressure' ? 'hot' : s.status}`}>{s.role}</span>
              <span class={`danger-badge danger-badge${s.dangerMod}`}>{s.danger}</span>
            </a>
          ) : (
            <div class={nodeClass} role="listitem">
              <span class={dotClass} aria-hidden="true"></span>
              <span class="node__name">{s.name}</span>
              <span class={`node__status node__status--${s.status === 'pressure' ? 'hot' : s.status}`}>{s.role}</span>
              <span class={`danger-badge danger-badge${s.dangerMod}`}>{s.danger}</span>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Sector detail cards for clickable active nodes -->
    <div class="module-grid" style="margin-top:1.5rem;">
      {sectors.filter(s => s.status === 'active').map(s => (
        <a class="module-card" href={s.link!} style="text-decoration:none;">
          <div class="mc__tag">Active</div>
          <div class="mc__title">{s.name}</div>
          <p class="mc__desc">{s.desc}</p>
          <span class={`danger-badge danger-badge${s.dangerMod}`} style="margin-top:0.5rem;">{s.danger} danger</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ─── THE DEAD LINE (metro panel) ─────────────────────────────────────────── -->
<section class="home-section">
  <div class="container container--narrow">
    <div class="hs__head">
      <span class="hs__label">Underground Layer</span>
      <h2 class="hs__title">The Dead Line</h2>
    </div>

    <div class="term-panel term-panel--teal">
      <div class="term-header">
        <span class="th__tag">Metro // Tunnel Spaces</span>
        <span class="th__rule"></span>
        <span class="th__info">Placeholder</span>
      </div>
      <div style="padding:1.25rem 1.5rem;">
        <p style="font-family:var(--font-mono); font-size:0.82rem; color:var(--text-dim); line-height:1.75; margin-bottom:0.9rem;">
          Metro and tunnel spaces are a future underground survival layer. First implementation target is stations, entrances, service rooms, blocked tunnels, and event corridors.
        </p>
        <p style="font-family:var(--font-mono); font-size:0.82rem; color:var(--text-dim); line-height:1.75; margin-bottom:0.9rem;">
          This is not a moving transit simulation. It is a set of underground spaces that connect to the surface sector map. The "Dead Line" refers to the metro network that stopped running before most people noticed the city was failing.
        </p>
        <p style="font-family:var(--font-mono); font-size:0.72rem; color:var(--amber); letter-spacing:0.08em;">
          Metro content is not in Season 0 scope. This is a planning note.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ─── SECTOR DESCRIPTIONS ───────────────────────────────────────────────── -->
<section class="home-section">
  <div class="container">
    <div class="hs__head">
      <span class="hs__label">Field Notes</span>
      <h2 class="hs__title">All Sectors</h2>
      <p class="hs__sub">Planning notes for all 10 sectors. Status reflects Season 0 build scope only.</p>
    </div>

    <div class="dispatch-feed">
      {sectors.map(s => (
        <div class="feed-item">
          <span class={`fi__type fi__type--${s.status === 'active' ? 'dispatch' : s.status === 'pressure' ? 'field' : s.status === 'planned' ? 'operator' : 'system'}`}>
            {s.status}
          </span>
          <div class="fi__body">
            <div class="fi__title">{s.name}</div>
            <p class="fi__text">{s.role} &mdash; {s.desc}</p>
          </div>
          <span class={`danger-badge danger-badge${s.dangerMod}`}>{s.danger}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── CTA ───────────────────────────────────────────────────────────────── -->
<section class="home-section" style="padding-block:2.5rem;">
  <div class="container">
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
      <a href="/saint-paul-emard/" class="term-btn term-btn--teal">S-P-E Dossier &rsaquo;</a>
      <a href="/knowledge/"        class="term-btn term-btn--ghost">Knowledge Center &rsaquo;</a>
      <a href="/dispatch/"         class="term-btn term-btn--ghost">Dispatches &rsaquo;</a>
    </div>
  </div>
</section>

</Base>

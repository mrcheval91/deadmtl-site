---
import Base from '../../layouts/Base.astro';
import DeadMtlInteractiveMap from '../../components/DeadMtlInteractiveMap.astro';

// Retained for the sector table below the interactive map
const sectors = [
  { name: 'Saint-Paul-Émard',    status: 'active',      role: 'Entry Enclave',    danger: 'medium',   dangerMod: '--medium',   desc: 'First active sector. Contained, fragmented, still manageable.',             link: '/saint-paul-emard/' },
  { name: 'Ville-Émard Core',    status: 'active',      role: 'Residential Node', danger: 'medium',   dangerMod: '--medium',   desc: 'Duplexes, ruelles, early caches. Heart of the first enclave.',              link: '/saint-paul-emard/' },
  { name: 'Côte-Saint-Paul',     status: 'active',      role: 'Industrial Fringe',danger: 'high',     dangerMod: '--high',     desc: 'Industrial corridors east of enclave. Workshops, garages, transit ruins.',   link: '/saint-paul-emard/' },
  { name: 'LaSalle Node',        status: 'pressure',    role: 'Pressure Source',  danger: 'critical', dangerMod: '--critical', desc: 'Major horde source. Pont Mercier barricade failure origin.',                 link: null },
  { name: 'Canal Edge',          status: 'active',      role: 'Industrial Route', danger: 'high',     dangerMod: '--high',     desc: 'Cold waterline strip. Fog, workshops, containers.',                         link: '/saint-paul-emard/' },
  { name: 'Angrignon Buffer',    status: 'planned',     role: 'Green Buffer',     danger: 'medium',   dangerMod: '--medium',   desc: 'Open park land, abandoned camps, migration from LaSalle.',                  link: null },
  { name: 'Verdun Edge',         status: 'locked',      role: 'Closed Sector',    danger: 'medium',   dangerMod: '--medium',   desc: 'Survivor pockets, rationing, tense access routes.',                         link: null },
  { name: 'Saint-Henri Approach',status: 'planned',     role: 'Future Expansion', danger: 'high',     dangerMod: '--high',     desc: 'Canal north bank. Industrial workshops, contested crossings.',               link: null },
  { name: 'Metro / Tunnel',      status: 'placeholder', role: 'Underground Layer',danger: 'unknown',  dangerMod: '--unknown',  desc: 'Future underground survival layer. Concept only.',                          link: null },
  { name: 'Pont Mercier',        status: 'pressure',    role: 'Collapse Origin',  danger: 'critical', dangerMod: '--critical', desc: 'Failed evacuation barricade. Primary horde flow source from the south.',    link: null },
] as const;

const mapLegend = [
  { mod: '--active',      label: 'Active — current build focus' },
  { mod: '--planned',     label: 'Planned — future scope' },
  { mod: '--locked',      label: 'Locked — outside current build' },
  { mod: '--pressure',    label: 'Pressure — threat / horde source' },
  { mod: '--placeholder', label: 'Placeholder — concept only' },
] as const;
---

<Base
  title="Map"
  description="DeadMTL sector map — southwest Montréal build scope. Interactive tactical reconstruction layer. Saint-Paul-Émard, LaSalle pressure, canal edges."
>

<div class="page-bbs-bar" aria-hidden="true">
  <span class="pbb__seg pbb__seg--active">Survey Division</span>
  <span class="pbb__seg">Tactical Map</span>
  <span class="pbb__seg pbb__seg--sys">MTL South-West</span>
  <span class="pbb__spacer"></span>
  <span class="pbb__ref">SEASON 0 // WINTER 93/94 // PROVISIONAL</span>
</div>

<!-- ─── HERO ──────────────────────────────────────────────────────────────── -->
<section class="term-hero" style="padding-block: clamp(2rem,5vw,4rem);">
  <div class="th__inner">
    <div class="th__eyebrow">SURVEY DIVISION // MTL GRID // SEASON 0</div>
    <div class="th__headline" style="font-size: clamp(1.8rem,5vw,3.5rem);">Network Map</div>
    <p class="th__body">
      The Network Map is a tactical reconstruction layer of the Montréal island.
      Public display is provisional. Some sectors are classified or pending operator review.
      Map uses borough boundaries as of 2002 — before post-merger revisions.
    </p>
    <p style="font-family:var(--font-mono); font-size:0.78rem; color:var(--amber); letter-spacing:0.1em; margin-bottom:1.5rem; line-height:1.6;">
      Under construction. Season 0 scope covers southwest Montréal only.<br />
      Sector names are planning labels. Server pending. Whitelist closed.
    </p>
    <div class="th__cta">
      <a href="/saint-paul-emard/" class="term-btn term-btn--teal">S-P-E Dossier &rsaquo;</a>
      <a href="/knowledge/"        class="term-btn term-btn--ghost">Knowledge &rsaquo;</a>
      <a href="/"                  class="term-btn term-btn--ghost">&larr; Home</a>
    </div>
  </div>
</section>

<!-- ─── INTERACTIVE MAP ───────────────────────────────────────────────────── -->
<section class="home-section" aria-label="Interactive tactical map">
  <div class="container" style="max-width:100%; padding-inline: var(--gap);">
    <div class="hs__head">
      <span class="hs__label">Tactical Map // Montréal Island</span>
      <h2 class="hs__title">Borough Tactical Overlay</h2>
      <p class="hs__sub">
        Click a borough for zone intel. Use mode buttons to switch overlay.
        Pan and zoom to navigate. Select zones have classified status redacted.
      </p>
    </div>

    <DeadMtlInteractiveMap />
  </div>
</section>

<!-- ─── SECTOR GRID — S0 SCOPE ────────────────────────────────────────────── -->
<section class="home-section">
  <div class="container">
    <div class="hs__head">
      <span class="hs__label">MTL Grid // Southwest Sectors</span>
      <h2 class="hs__title">Season 0 Sector Survey</h2>
      <p class="hs__sub">10 planning sectors. Season 0 active zones shown in teal. All others are planned, locked, or under pressure.</p>
    </div>

    <div class="sector-legend">
      {mapLegend.map(item => (
        <span class="sl__item">
          <span class={`sl__dot sl__dot${item.mod}`}></span>
          {item.label}
        </span>
      ))}
    </div>

    <div class="net-grid-panel" style="margin-top:0.75rem;">
      <div class="term-header">
        <span class="th__tag">Sector Grid // Southwest Montréal</span>
        <span class="th__rule"></span>
        <span class="th__info">Season 0 scope</span>
      </div>
      <div class="ngp__grid" role="list">
        {sectors.map(s => {
          const nodeClass = `net-node net-node--${s.status === 'pressure' ? 'hot' : s.status}`;
          const dotClass  = `node__dot node__dot--${s.status === 'pressure' ? 'hot' : s.status === 'active' ? 'active' : 'locked'}`;
          return s.link ? (
            <a class={nodeClass} href={s.link} role="listitem" style="text-decoration:none;">
              <span class={dotClass} aria-hidden="true"></span>
              <span class="node__name">{s.name}</span>
              <span class={`node__status node__status--${s.status === 'pressure' ? 'hot' : s.status}`}>{s.role}</span>
              <span class={`danger-badge danger-badge${s.dangerMod}`}>{s.danger}</span>
            </a>
          ) : (
            <div class={nodeClass} role="listitem">
              <span class={dotClass} aria-hidden="true"></span>
              <span class="node__name">{s.name}</span>
              <span class={`node__status node__status--${s.status === 'pressure' ? 'hot' : s.status}`}>{s.role}</span>
              <span class={`danger-badge danger-badge${s.dangerMod}`}>{s.danger}</span>
            </div>
          );
        })}
      </div>
    </div>

    <div class="module-grid" style="margin-top:1.5rem;">
      {sectors.filter(s => s.status === 'active').map(s => (
        <a class="module-card" href={s.link!} style="text-decoration:none;">
          <div class="mc__tag">Active</div>
          <div class="mc__title">{s.name}</div>
          <p class="mc__desc">{s.desc}</p>
          <span class={`danger-badge danger-badge${s.dangerMod}`} style="margin-top:0.5rem;">{s.danger} danger</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ─── THE DEAD LINE ─────────────────────────────────────────────────────── -->
<section class="home-section">
  <div class="container container--narrow">
    <div class="hs__head">
      <span class="hs__label">Underground Layer</span>
      <h2 class="hs__title">The Dead Line</h2>
    </div>

    <div class="term-panel term-panel--teal">
      <div class="term-header">
        <span class="th__tag">Metro // Tunnel Spaces</span>
        <span class="th__rule"></span>
        <span class="th__info">Placeholder</span>
      </div>
      <div style="padding:1.25rem 1.5rem;">
        <p style="font-family:var(--font-mono); font-size:0.82rem; color:var(--text-dim); line-height:1.75; margin-bottom:0.9rem;">
          Metro and tunnel spaces are a future underground survival layer. First implementation target is stations, entrances, service rooms, blocked tunnels, and event corridors.
        </p>
        <p style="font-family:var(--font-mono); font-size:0.72rem; color:var(--amber); letter-spacing:0.08em;">
          Metro content is not in Season 0 scope. This is a planning note.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ─── ALL SECTORS ───────────────────────────────────────────────────────── -->
<section class="home-section">
  <div class="container">
    <div class="hs__head">
      <span class="hs__label">Field Notes</span>
      <h2 class="hs__title">All Sectors</h2>
      <p class="hs__sub">Planning notes for all 10 sectors. Status reflects Season 0 build scope only.</p>
    </div>

    <div class="dispatch-feed">
      {sectors.map(s => (
        <div class="feed-item">
          <span class={`fi__type fi__type--${s.status === 'active' ? 'dispatch' : s.status === 'pressure' ? 'field' : s.status === 'planned' ? 'operator' : 'system'}`}>
            {s.status}
          </span>
          <div class="fi__body">
            <div class="fi__title">{s.name}</div>
            <p class="fi__text">{s.role} &mdash; {s.desc}</p>
          </div>
          <span class={`danger-badge danger-badge${s.dangerMod}`}>{s.danger}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── CTA ───────────────────────────────────────────────────────────────── -->
<section class="home-section" style="padding-block:2.5rem;">
  <div class="container">
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
      <a href="/saint-paul-emard/" class="term-btn term-btn--teal">S-P-E Dossier &rsaquo;</a>
      <a href="/knowledge/"        class="term-btn term-btn--ghost">Knowledge &rsaquo;</a>
      <a href="/dispatch/"         class="term-btn term-btn--ghost">Dispatch &rsaquo;</a>
    </div>
  </div>
</section>

</Base>

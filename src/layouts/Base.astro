---
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'DeadMTL &mdash; R&eacute;seau de survie montr&eacute;alais. Serveur, archives, bulletins, carte. Saison 0 en configuration.',
  bodyClass = '',
} = Astro.props;

const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}

const navLinks = [
  { href: '/',              label: 'Accueil' },
  { href: '/rules/',        label: 'R&egrave;gles' },
  { href: '/join/',         label: 'Rejoindre' },
  { href: '/construction/', label: 'Statut' },
  { href: '/dispatch/',     label: 'Transmissions' },
  { href: '/saint-paul-emard/', label: 'S-P-E' },
  { href: '/map/',          label: 'Carte' },
  { href: '/knowledge/',    label: 'Connaissances' },
  { href: '/assets/',       label: 'Ressources' },
  { href: '/community/',    label: 'Communaut&eacute;' },
];
---

<!doctype html>
<html lang="fr-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <title>{title} // DEADMTL NETWORK</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class={bodyClass}>

<header class="network-bar" role="banner">

  <!-- Top identity row -->
  <div class="nb__top">
    <a class="nb__brand" href="/" aria-label="DeadMTL accueil">DEADMTL</a>
    <span class="nb__sep" aria-hidden="true">//</span>
    <span class="nb__subtitle">R&eacute;seau Survivant &bull; Montr&eacute;al</span>
    <span class="nb__spacer" aria-hidden="true"></span>
    <span class="nb__status" aria-label="Saison 0 en configuration">Saison 0 &mdash; En Configuration</span>
    <span id="site-clock" class="term-clock" aria-live="off" aria-hidden="true"></span>

    <button
      class="nb__toggle"
      aria-expanded="false"
      aria-controls="nb-menu"
      aria-label="Basculer la navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Nav link row -->
  <nav id="nb-menu" class="nb__links" aria-label="Navigation principale">
    {navLinks.map(({ href, label }) => (
      <a href={href} class={isActive(href) ? 'active' : ''} set:html={label} />
    ))}
  </nav>

</header>

<slot />

<footer class="term-footer">
  <div class="container tf__inner">
    <div>
      <a class="tf__brand" href="/">DEADMTL</a>
      <p class="tf__tagline">Survivre. S&rsquo;adapter. Se connecter.</p>
      <p class="tf__note">
        R&eacute;seau de survie montr&eacute;alais &mdash; Saison 0 en configuration. Serveur pas encore ouvert.<br />
        Projet communautaire ind&eacute;pendant. Non affili&eacute; &agrave; The Indie Stone.<br />
        Pas de pay-to-win. Pas d&rsquo;avantage donateur. Pas de fausses affirmations.
      </p>
    </div>
    <nav class="tf__links" aria-label="Navigation pied de page">
      <a href="/rules/">R&egrave;gles</a>
      <a href="/join/">Rejoindre</a>
      <a href="/construction/">Statut</a>
      <a href="/dispatch/">Transmissions</a>
      <a href="/saint-paul-emard/">Dossier S-P-E</a>
      <a href="/map/">Carte</a>
      <a href="/knowledge/">Connaissances</a>
      <a href="/assets/">Ressources</a>
    </nav>
  </div>
</footer>

<script src="/scripts/main.js" defer></script>
</body>
</html>

---
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'DeadMTL — Montréal survival network. Server, lore archive, dispatch, map. Season 0 in setup.',
  bodyClass = '',
} = Astro.props;

const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}

const navLinks = [
  { href: '/',              label: 'Home' },
  { href: '/rules/',        label: 'Rules' },
  { href: '/join/',         label: 'Join' },
  { href: '/construction/', label: 'Status' },
  { href: '/dispatch/',     label: 'Dispatch' },
  { href: '/saint-paul-emard/', label: 'S-P-E' },
  { href: '/map/',          label: 'Map' },
  { href: '/knowledge/',    label: 'Knowledge' },
  { href: '/assets/',       label: 'Assets' },
  { href: '/community/',    label: 'Community' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <title>{title} // DEADMTL NETWORK</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <slot name="head" />
</head>
<body class={bodyClass}>

<header class="network-bar" role="banner">

  <!-- Top identity row -->
  <div class="nb__top">
    <a class="nb__brand" href="/" aria-label="DeadMTL home">DEADMTL</a>
    <span class="nb__sep" aria-hidden="true">//</span>
    <span class="nb__subtitle">Survival Network &bull; Montréal</span>
    <span class="nb__spacer" aria-hidden="true"></span>
    <span class="nb__status" aria-label="Season 0 in setup">Season 0 &mdash; Setup</span>
    <span id="site-clock" class="term-clock" aria-live="off" aria-hidden="true"></span>

    <button
      class="nb__toggle"
      aria-expanded="false"
      aria-controls="nb-menu"
      aria-label="Toggle navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Nav link row -->
  <nav id="nb-menu" class="nb__links" aria-label="Main navigation">
    {navLinks.map(({ href, label }) => (
      <a href={href} class={isActive(href) ? 'active' : ''}>{label}</a>
    ))}
  </nav>

</header>

<slot />

<footer class="term-footer">
  <div class="container tf__inner">
    <div>
      <a class="tf__brand" href="/">DEADMTL</a>
      <p class="tf__tagline">Survive. Adapt. Connect.</p>
      <p class="tf__note">
        Montréal survival network &mdash; Season 0 in setup. Server not yet open.<br />
        Independent community project. Not affiliated with The Indie Stone.<br />
        No pay-to-win. No donor perks. No fake claims.
      </p>
    </div>
    <nav class="tf__links" aria-label="Footer navigation">
      <a href="/rules/">Rules</a>
      <a href="/join/">Join</a>
      <a href="/construction/">Status</a>
      <a href="/dispatch/">Dispatch</a>
      <a href="/saint-paul-emard/">S-P-E Dossier</a>
      <a href="/map/">Map</a>
      <a href="/knowledge/">Knowledge</a>
      <a href="/assets/">Assets</a>
    </nav>
  </div>
</footer>

<script src="/scripts/main.js" defer></script>
</body>
</html>

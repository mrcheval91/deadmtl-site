---
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'DeadMTL — Montreal survival world, lore archive, and server hub. Set after the Knox Event, winter 1993–1994.',
  bodyClass = '',
} = Astro.props;

const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <title>{title} — DeadMTL</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class={bodyClass}>

<nav class="site-nav" aria-label="Main navigation">
  <div class="container nav-inner">
    <a class="nav-brand" href="/" aria-label="DeadMTL home">DEADMTL</a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Toggle navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-links" id="nav-menu" role="list">
      <li><a href="/" class={isActive('/') ? 'active' : ''}>Home</a></li>
      <li><a href="/saint-paul-emard/" class={isActive('/saint-paul-emard') ? 'active' : ''}>S-P-E</a></li>
      <li><a href="/dispatch" class={isActive('/dispatch') ? 'active' : ''}>Dispatch</a></li>
      <li><a href="/archive" class={isActive('/archive') ? 'active' : ''}>Archive</a></li>
      <li><a href="/map" class={isActive('/map') ? 'active' : ''}>Map</a></li>
      <li><a href="/construction" class={isActive('/construction') ? 'active' : ''}>Status</a></li>
    </ul>
  </div>
</nav>

<slot />

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="footer-brand" href="/">DEADMTL</a>
      <p class="footer-line">
        Montreal survival world. Set after the Knox Event, winter 1993&ndash;1994.<br />
        DeadMTL is an independent community project, not affiliated with The Indie Stone.
      </p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/">Home</a>
      <a href="/saint-paul-emard/">S-P-E</a>
      <a href="/dispatch">Dispatch</a>
      <a href="/archive">Archive</a>
      <a href="/map">Map</a>
      <a href="/construction">Status</a>
    </nav>
  </div>
</footer>

<script src="/scripts/main.js" defer></script>
</body>
</html>
